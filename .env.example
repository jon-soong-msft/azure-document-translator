# ============================================================================
# This app supports TWO authentication modes. Pick whichever fits your resource.
#
#  A) Microsoft Entra ID (keyless, recommended) - used when no *_KEY is set.
#     Works locally via "az login" (DefaultAzureCredential) and via managed
#     identity when hosted in Azure. Requires the "Cognitive Services User"
#     role on the resource. Use this if your resource has local-auth/keys
#     disabled (disableLocalAuth = true).
#
#  B) Resource key - used when an *_KEY value is provided below.
# ============================================================================

# ----------------------------------------------------------------------------
# Azure AI Document Intelligence (OCR)
# Resource type: "Document intelligence" / multi-service Cognitive Services
# ----------------------------------------------------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
# Mode B only. Leave unset/empty to use Microsoft Entra ID (mode A).
# AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-document-intelligence-key>

# ----------------------------------------------------------------------------
# Azure AI Translator (Text Translation)
# ----------------------------------------------------------------------------
# Region of your Translator / multi-service resource, e.g. eastus, northcentralus.
AZURE_TRANSLATOR_REGION=<your-translator-region>

# Mode A (keyless) only: full resource ID, required for the global endpoint.
# Format: /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name>
AZURE_TRANSLATOR_RESOURCE_ID=<your-translator-resource-id>

# Mode B only. Leave unset/empty to use Microsoft Entra ID (mode A).
# AZURE_TRANSLATOR_KEY=<your-translator-key>

# Optional. Leave as-is unless you use a custom/regional endpoint.
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# ----------------------------------------------------------------------------
# Layout-preserving Document Translation ("Preserve layout" mode)
# Uses the synchronous Document Translation endpoint on your resource's custom
# domain. Defaults to AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT (same resource), so
# you usually don't need to set this. Override only if it lives elsewhere.
# ----------------------------------------------------------------------------
# AZURE_DOCUMENT_TRANSLATION_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/

# ----------------------------------------------------------------------------
# Batch (layout-preserving) PDF translation — OPTIONAL.
# Set these to enable translating PDFs while keeping their layout. They require
# an Azure Blob Storage account; the Translator resource's managed identity must
# have "Storage Blob Data Contributor" on it. All of this is provisioned for you
# by `azd up` (see infra/). Without these, PDFs fall back to Text view.
# ----------------------------------------------------------------------------
# AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account>
# AZURE_STORAGE_BLOB_ENDPOINT=https://<your-storage-account>.blob.core.windows.net/
# AZURE_STORAGE_SOURCE_CONTAINER=source
# AZURE_STORAGE_TARGET_CONTAINER=target

# ----------------------------------------------------------------------------
# Managed identity selector — OPTIONAL.
# When the app runs with a user-assigned managed identity (e.g. in Container
# Apps), set this to that identity's client id so DefaultAzureCredential uses it.
# Leave unset for local dev (uses your `az login`).
# ----------------------------------------------------------------------------
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>

# ----------------------------------------------------------------------------
# App sign-in gate.
# The app requires a username + password before it can be used. Set the single
# valid credential pair here, plus a long random secret used to sign the
# session cookie. In Azure, set these as Container App secrets/env vars.
# ----------------------------------------------------------------------------
APP_USERNAME=<choose-a-username>
APP_PASSWORD=<choose-a-password>
AUTH_SECRET=<a-long-random-string-used-to-sign-the-session-cookie>

# ----------------------------------------------------------------------------
# Evaluation report — OPTIONAL feature flag.
# Per translation, the user can opt in (via a UI toggle) to an evaluation report
# showing characters, estimated cost and processing time. It is never run unless
# requested, so it adds no overhead to normal translations. Set to 'false' to
# hide the feature entirely. Defaults to enabled when unset.
# ----------------------------------------------------------------------------
# EVALUATION_ENABLED=true

# ----------------------------------------------------------------------------
# Application Insights (end-to-end distributed tracing) — OPTIONAL.
# When set, the app enables the Azure Monitor OpenTelemetry Distro and exports
# requests, dependencies, custom pipeline spans, metrics and Live Metrics to
# Application Insights. `azd up` provisions the resource and injects this value
# in Azure; set it here only if you also want traces while running locally.
# Leave unset for local dev — tracing simply stays off with zero overhead.
# ----------------------------------------------------------------------------
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
# OTEL_SERVICE_NAME=doc-translator
# Set to 1 to disable the stdout translation telemetry line (on by default).
# TELEMETRY_DISABLED=1
